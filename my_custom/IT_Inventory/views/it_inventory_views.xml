    <!-- Tree View -->
    <record id="it_inventory_view_tree" model="ir.ui.view">
        <field name="name">it_inventory.tree</field>
        <field name="model">it.inventory</field>
        <field name="arch" type="xml">
            <list string="it" editable="bottom">
                        <field name="count"/>
                        <field name="serial"/>
                        <field name="emp_id"/>
                        <field name="fullname"/>
                        <field name="email"/>
                        <field name="unit"/>
                        <field name="section"/>
                        <field name="category"/>
                        <field name="brand_model"/>
                        <field name="configuration"/>
                        <field name="cpu_serial"/>
                        <field name="cpu_asset"/>
                        <field name="hostname"/>
                        <field name="cpu_purchase_date"/>
<!--                        <field name="cpu_dt"/>-->
                        <field name="cpu_age"/>
                        <field name="cpu_purchase_value"/>
                        <field name="monitor_brand"/>
                        <field name="m_serial"/>
                        <field name="m_serial"/>
                        <field name="moni_purchase_date"/>
<!--                        <field name="m_dt"/>-->
                        <field name="m_age"/>
                        <field name="m_purchase_value"/>
                        <field name="ups_brand"/>
                        <field name="ups_serial"/>
                        <field name="ups_asset"/>
                        <field name="u_purchase_date"/>
<!--                        <field name="ups_dt"/>-->
                        <field name="ups_age"/>
                        <field name="u_purchase_value"/>
                        <field name="remarks"/>
                        <field name="remarks2"/>

            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="it_inventory_model_action" model="ir.actions.act_window">
        <field name="name">IT Inventory</field>
        <field name="res_model">it.inventory</field>
        <field name="view_mode">list,form</field>
    </record>


