    <!-- Tree View -->
    <record id="laptop_view_tree" model="ir.ui.view">
        <field name="name">laptop.tree</field>
        <field name="model">laptop</field>
        <field name="arch" type="xml">
            <list string="laptop" editable="bottom">
                        <field name="count"/>
                        <field name="serial"/>
                        <field name="emp_id"/>
                        <field name="fullname"/>
                        <field name="email"/>
                        <field name="unit"/>
                        <field name="section"/>
                        <field name="category"/>
                        <field name="brand_model"/>
                        <field name="configuration"/>
                        <field name="laptop_serial"/>
                        <field name="laptop_asset"/>
                        <field name="hostname"/>
                        <field name="laptop_purchase_date"/>
<!--                        <field name="cpu_dt"/>-->
                        <field name="laptop_age"/>
                        <field name="laptop_purchase_value"/>
                        <field name="monitor_brand"/>
                        <field name="m_serial"/>
                        <field name="m_serial"/>
                        <field name="moni_purchase_date"/>
<!--                        <field name="m_dt"/>-->
                        <field name="m_age"/>
                        <field name="m_purchase_value"/>
                        <field name="remarks"/>
                        <field name="remarks2"/>

            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="laptop_model_action" model="ir.actions.act_window">
        <field name="name">Laptop</field>
        <field name="res_model">laptop</field>
        <field name="view_mode">list,form</field>
    </record>
