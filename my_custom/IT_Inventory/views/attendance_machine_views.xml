    <!-- Tree View -->
    <record id="attendance_machine_view_tree" model="ir.ui.view">
        <field name="name">attendance_machine.tree</field>
        <field name="model">attendance_machine</field>
        <field name="arch" type="xml">
            <list string="attendance_machine" editable="bottom">
                        <field name="count"/>
                        <field name="serial"/>
                        <field name="emp_id"/>
                        <field name="fullname"/>
                        <field name="email"/>
                        <field name="unit"/>
                        <field name="section"/>
                        <field name="category"/>
                        <field name="brand"/>
                        <field name="model"/>
                        <field name="configuration"/>
                        <field name="attendance_machine_serial"/>
                        <field name="attendance_machine_asset"/>
                        <field name="attendance_machine_IP"/>
                        <field name="hostname"/>
                        <field name="attendance_machine_purchase_date"/>
                        <field name="attendance_machine_age"/>
                        <field name="attendance_machine_purchase_value"/>
                        <field name="remarks"/>
                        <field name="remarks2"/>

            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="attendance_machine_model_action" model="ir.actions.act_window">
        <field name="name">Attendance Machine</field>
        <field name="res_model">attendance_machine</field>
        <field name="view_mode">list,form</field>
    </record>
